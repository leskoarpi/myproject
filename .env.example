# Copy to .env and fill in. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-generate-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

POSTGRES_DB=deakkoli
POSTGRES_USER=deakkoli
POSTGRES_PASSWORD=change-me

# Published port for nginx. 80 needs no sudo under Docker Desktop; set it
# to something else (e.g. 8080) if port 80 is already taken on this host.
HTTP_PORT=80
INSTALL_DEV=true

# Destructive maintenance stays off unless deliberately enabled.
ALLOW_DESTRUCTIVE_MAINTENANCE=true

# Domain tuning
MORNING_CUTOFF_HOUR=4
INSPECTION_LOCK_TIMEOUT_SECONDS=300
LOGIN_RATELIMIT_ATTEMPTS=8
